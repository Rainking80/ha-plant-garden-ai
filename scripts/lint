#!/usr/bin/env bash
# Lint, format-check and type-check backend and frontend.
# Pass --fix to apply automatic fixes.
set -euo pipefail
source "$(dirname "$0")/env.sh"
cd "$REPO_ROOT"

if [[ "${1:-}" == "--fix" ]]; then
  uv run --frozen ruff check --fix .
  uv run --frozen ruff format .
  (cd frontend && npm run --silent format && npm run --silent lint -- --fix)
else
  uv run --frozen ruff check .
  uv run --frozen ruff format --check .
  (cd frontend && npm run --silent format:check && npm run --silent lint)
fi
uv run --frozen mypy
(cd frontend && npm run --silent typecheck)
